# PostgreSQL is the production default. Keep secrets in an untracked .env or a secret store.
DATABASE_URL=

# Comma-separated ordered provider URLs. Credentials, if required, belong in separate env vars.
XRPL_PROVIDER_URLS=wss://s1.ripple.com

# Optional single-process local development database.
SQLITE_DATABASE_PATH=./data/scout.sqlite

# Leave blank until Discord delivery is explicitly configured.
DISCORD_WEBHOOK_URL=
